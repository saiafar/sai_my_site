# Variables del despliegue en Dokploy (servicio Compose → Environment).
# No se suben al repositorio: se pegan en el panel.

SITE_DOMAIN=rafaiasvillan.com

# --- Base de datos -----------------------------------------------------------
# El host es siempre "postgres", el alias que el contenedor ya tiene en su red.
POSTGRES_USER=sai_agent
POSTGRES_PASSWORD=
POSTGRES_DB=sai_agent
POSTGRES_NETWORK=sai-postgrespgvector-th12oq_default

# --- Asistente ---------------------------------------------------------------
# Sin clave se usa el proveedor simulado: el sitio funciona y el asistente
# responde con un texto de muestra en lugar de fallar.
GEMINI_API_KEY=
# gemini-2.5-flash ya no está disponible para cuentas nuevas (404).
# "minimal" solo lo aceptan los modelos lite: con gemini-3.8-flash usa "low".
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal

# Valor aleatorio y estable. Genera el tuyo con:  openssl rand -hex 32
CLIENT_KEY_SALT=

MONTHLY_BUDGET_USD=5
RATE_LIMIT_PER_HOUR=30

# Ponlo a "true" cuando el corpus esté listo para que lo vea un buscador.
SITE_INDEXABLE=false
